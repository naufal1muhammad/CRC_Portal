    <!-- SSDT allows only one PostDeploy script (Script.PostDeployment.sql); it :r-includes the
         individual seed files, which are carried in the project as None so they are
         source-controlled but not compiled as schema objects. -->
    <PostDeploy Include="Scripts\Script.PostDeployment.sql" />
    <None Include="Scripts\Seed_Lookups.sql" />
    <None Include="Scripts\Seed_Location.sql" />
    <!-- The generator for Seed_Location.sql. Carried as None purely so it stays
         visible in Solution Explorer beside the file it writes; it is not
         compiled, not deployed, and never runs during a publish. -->
    <None Include="Scripts\Tools\New-SeedLocation.ps1" />
