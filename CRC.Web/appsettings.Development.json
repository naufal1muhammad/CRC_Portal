{
  "ConnectionStrings": {
    "CRC_DB": "Server=localhost;Database=CRC_DB;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "Agent": {
    "ApiKey": [ "dev-only-agent-key-change-me" ]
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Account": {
    "Password": {
      "RequireDigit": true,
      "RequireLowercase": true,
      "RequireNonAlphanumeric": true,
      "RequireUppercase": true,
      "RequiredLength": 12,
      "RequiredUniqueChars": 2
    }
  }
}