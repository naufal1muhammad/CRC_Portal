@{
    ViewData["Title"] = "Staff Dashboard";
}

<div class="mb-3">
    <h2 class="mb-1">Dashboard</h2>
</div>

<!-- Message area -->
<div id="staffDashboardMessage" class="small mb-3"></div>

<div class="row g-3">

    <!-- Row 1: Today's Appointments -->
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header d-flex align-items-center justify-content-between">
                <div>
                    <h5 class="mb-0">Today’s Appointments</h5>
                </div>
                <div class="text-muted small">
                    <i class="fas fa-calendar-day me-1"></i>
                    @DateTime.Today.ToString("dd/MM/yyyy")
                </div>
            </div>

            <div class="card-body">
                <div id="todayAppointmentsMsg" class="small mb-2 text-muted"></div>

                <div class="table-responsive">
                    <table id="todayAppointmentsTable" class="table table-sm table-striped table-hover align-middle w-100">
                        <thead></thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Row 2: This Week's Appointments -->
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header d-flex align-items-center justify-content-between">
                <div>
                    <h5 class="mb-0">This Week’s Appointments</h5>
                </div>
                <div class="text-muted small">
                    <i class="fas fa-calendar-week me-1"></i>
                    <span id="weekRangeLabel"></span>
                </div>
            </div>

            <div class="card-body">
                <div id="weekAppointmentsMsg" class="small mb-2 text-muted"></div>

                <div class="table-responsive">
                    <table id="weekAppointmentsTable" class="table table-sm table-striped table-hover align-middle w-100">
                        <thead></thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Row 3: This Month's Appointments -->
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header d-flex align-items-center justify-content-between">
                <div>
                    <h5 class="mb-0">This Month’s Appointments</h5>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <button type="button" id="monthPrevBtn" class="btn btn-sm btn-outline-secondary" title="Previous month">
                        <i class="fas fa-chevron-left"></i>
                    </button>

                    <input type="month" id="monthPicker" class="form-control form-control-sm" style="max-width: 160px;" />

                    <button type="button" id="monthNextBtn" class="btn btn-sm btn-outline-secondary" title="Next month">
                        <i class="fas fa-chevron-right"></i>
                    </button>
                </div>
            </div>

            <div class="card-body">
                <div id="monthAppointmentsMsg" class="small mb-2 text-muted"></div>

                <div class="table-responsive">
                    <table id="monthAppointmentsTable" class="table table-sm table-striped table-hover align-middle w-100">
                        <thead></thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/staffDashboard/index.js"></script>
}