@{
    ViewData["Title"] = "Patient Tracker";
    Layout = "_Layout";
}

<div class="container-fluid py-3" id="patientTrackerPage">

    <!-- Page Header -->
    <div class="d-flex align-items-center mb-3">
        <h2 class="mb-0">Patient Tracker</h2>
    </div>

    <!-- Summary cards -->
    <div class="row g-3 mb-3">
        <div class="col-md-4 col-lg-3">
            <div class="card h-100 shadow-sm border-start border-4 border-warning">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-warning bg-opacity-25 d-flex align-items-center justify-content-center me-3"
                         style="width:48px;height:48px;">
                        <i class="fas fa-pause-circle text-warning fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small text-uppercase">Stalled</div>
                        <div class="fs-3 fw-bold" id="stalledCount">0</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Search & filter -->
    <div class="card mb-3 shadow-sm">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-6 col-lg-5">
                    <label class="form-label small text-uppercase text-muted mb-1">Search</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="fas fa-search"></i></span>
                        <input type="text"
                               id="trackerSearchInput"
                               class="form-control"
                               placeholder="Search by Patient Name, Patient ID or NRIC..." />
                    </div>
                </div>

                <div class="col-md-6 col-lg-7">
                    <label class="form-label small text-uppercase text-muted mb-1">Filter by Appointment Type</label>
                    <div id="trackerFilterChips" class="d-flex flex-wrap gap-2">
                        <span class="text-muted small">Loading filters...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Patient list -->
    <div id="trackerPatientList">
        <div class="text-center text-muted py-5">Loading patients...</div>
    </div>
</div>

@section Scripts {
    <script src="~/js/patientTracker/index.js" asp-append-version="true"></script>
}
