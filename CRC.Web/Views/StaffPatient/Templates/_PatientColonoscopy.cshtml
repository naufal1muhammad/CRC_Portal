@* Patient Colonoscopy Template (loaded into modal dynamically) *@

<div id="tmplPatientColonoscopy">
    <!-- Colonoscopy Section -->
    <div class="card mb-3">
        <div class="card-header">
            <strong>Colonoscopy</strong>
        </div>
        <div class="card-body row g-3">
            <div class="col-md-4">
                <label class="form-label">1. Status <span class="text-danger">*</span></label>
                <select id="pc_colonoscopyStatus" class="form-select">
                    <option value="">-- Select --</option>
                    <option value="true">COMPLETE</option>
                    <option value="false">INCOMPLETE</option>
                </select>
            </div>

            <div class="col-md-8" id="wrap_pc_colonoscopyStatusDetails" style="display:none;">
                <label class="form-label">2. If INCOMPLETE, please specify <span class="text-danger">*</span></label>
                <input id="pc_colonoscopyStatusDetails" class="form-control" type="text" maxlength="500" />
            </div>
        </div>
    </div>

    <!-- Bowel Preparation Section -->
    <div class="card mb-3">
        <div class="card-header">
            <strong>Bowel Preparation</strong>
        </div>
        <div class="card-body row g-3">
            <div class="col-md-6">
                <label class="form-label">3. Bowel Preparedness <span class="text-danger">*</span></label>
                <select id="pc_bowelPreparation" class="form-select">
                    <option value="">-- Select --</option>
                    <option value="0">0 - INADEQUATE</option>
                    <option value="1">1 - POOR</option>
                    <option value="2">2 - GOOD</option>
                    <option value="3">3 - EXCELLENT</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Findings Section -->
    <div class="card mb-3">
        <div class="card-header">
            <strong>Findings</strong>
        </div>
        <div class="card-body">

            <!-- Reusable Anomaly Details Template (stamped per organ via JS) -->
            <template id="pcAnomalyTemplate">
                <div class="card card-body bg-light mt-2 p-2">
                    <p class="text-muted small mb-2"><strong>Anomaly Details &mdash; <span data-anomaly-label></span></strong> <span class="text-muted">(all fields optional)</span></p>
                    <div class="table-responsive">
                        <table class="table table-bordered table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr><th style="width:35%;">Field</th><th>Value</th></tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><label class="form-label mb-0">Type of Anomaly</label></td>
                                    <td>
                                        <select data-anomaly-field="TypeOfAnomaly" class="form-select form-select-sm">
                                            <option value="">-- Select --</option>
                                            <option value="Polyps">Polyps</option>
                                            <option value="Mass/Tumor">Mass/Tumor</option>
                                            <option value="Ulcer/Erosion">Ulcer/Erosion</option>
                                            <option value="Inflammation">Inflammation</option>
                                            <option value="Diverticulum">Diverticulum</option>
                                            <option value="Stricture">Stricture</option>
                                            <option value="Vascular Lesion">Vascular Lesion</option>
                                            <option value="Other">Other</option>
                                        </select>
                                    </td>
                                </tr>
                                <tr>
                                    <td><label class="form-label mb-0">Size (mm)</label></td>
                                    <td><input data-anomaly-field="Size" type="text" class="form-control form-control-sm" maxlength="50" /></td>
                                </tr>
                                <tr>
                                    <td><label class="form-label mb-0">Count</label></td>
                                    <td><input data-anomaly-field="Count" type="text" class="form-control form-control-sm" maxlength="50" /></td>
                                </tr>
                                <tr>
                                    <td><label class="form-label mb-0">Morphology (Paris)</label></td>
                                    <td>
                                        <select data-anomaly-field="Morphology" class="form-select form-select-sm">
                                            <option value="">-- Select --</option>
                                            <option value="0-Ip (Pedunculated)">0-Ip (Pedunculated)</option>
                                            <option value="0-Isp (Sub-pedunculated)">0-Isp (Sub-pedunculated)</option>
                                            <option value="0-Is (Sessile)">0-Is (Sessile)</option>
                                            <option value="0-IIa (Flat elevated)">0-IIa (Flat elevated)</option>
                                            <option value="0-IIb (Completely flat)">0-IIb (Completely flat)</option>
                                            <option value="0-IIc (Depressed)">0-IIc (Depressed)</option>
                                            <option value="0-III (Excavated)">0-III (Excavated)</option>
                                        </select>
                                    </td>
                                </tr>
                                <tr>
                                    <td><label class="form-label mb-0">Intervention</label></td>
                                    <td>
                                        <select data-anomaly-field="Intervention" class="form-select form-select-sm">
                                            <option value="">-- Select --</option>
                                            <option value="Polypectomy">Polypectomy</option>
                                            <option value="Biopsy">Biopsy</option>
                                            <option value="EMR">EMR</option>
                                            <option value="ESD">ESD</option>
                                            <option value="APC">APC</option>
                                            <option value="Clipping">Clipping</option>
                                            <option value="Tattooing">Tattooing</option>
                                            <option value="None">None</option>
                                            <option value="Other">Other</option>
                                        </select>
                                    </td>
                                </tr>
                                <tr>
                                    <td><label class="form-label mb-0">Remarks</label></td>
                                    <td><input data-anomaly-field="Remarks" type="text" class="form-control form-control-sm" maxlength="500" /></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </template>

            <div class="row g-3">
                <!-- 4. Anus -->
                <div class="col-md-6 col-lg-4">
                    <label class="form-label">4. Anus <span class="text-danger">*</span></label>
                    <select id="pc_findingsAnus" class="form-select pc-findings-select" data-organ="Anus">
                        <option value="">-- Select --</option>
                        <option value="true">NORMAL</option>
                        <option value="false">ABNORMAL</option>
                    </select>
                    <div id="wrap_pc_findingsAnusDetails" style="display:none;"></div>
                </div>

                <!-- 5. Rectum -->
                <div class="col-md-6 col-lg-4">
                    <label class="form-label">5. Rectum <span class="text-danger">*</span></label>
                    <select id="pc_findingsRectum" class="form-select pc-findings-select" data-organ="Rectum">
                        <option value="">-- Select --</option>
                        <option value="true">NORMAL</option>
                        <option value="false">ABNORMAL</option>
                    </select>
                    <div id="wrap_pc_findingsRectumDetails" style="display:none;"></div>
                </div>

                <!-- 6. Sigmoid Colon -->
                <div class="col-md-6 col-lg-4">
                    <label class="form-label">6. Sigmoid Colon <span class="text-danger">*</span></label>
                    <select id="pc_findingsSigmoidColon" class="form-select pc-findings-select" data-organ="SigmoidColon">
                        <option value="">-- Select --</option>
                        <option value="true">NORMAL</option>
                        <option value="false">ABNORMAL</option>
                    </select>
                    <div id="wrap_pc_findingsSigmoidColonDetails" style="display:none;"></div>
                </div>

                <!-- 7. Descending Colon -->
                <div class="col-md-6 col-lg-4">
                    <label class="form-label">7. Descending Colon <span class="text-danger">*</span></label>
                    <select id="pc_findingsDescendingColon" class="form-select pc-findings-select" data-organ="DescendingColon">
                        <option value="">-- Select --</option>
                        <option value="true">NORMAL</option>
                        <option value="false">ABNORMAL</option>
                    </select>
                    <div id="wrap_pc_findingsDescendingColonDetails" style="display:none;"></div>
                </div>

                <!-- 8. Splenic Flexure -->
                <div class="col-md-6 col-lg-4">
                    <label class="form-label">8. Splenic Flexure <span class="text-danger">*</span></label>
                    <select id="pc_findingsSplenicFlexure" class="form-select pc-findings-select" data-organ="SplenicFlexure">
                        <option value="">-- Select --</option>
                        <option value="true">NORMAL</option>
                        <option value="false">ABNORMAL</option>
                    </select>
                    <div id="wrap_pc_findingsSplenicFlexureDetails" style="display:none;"></div>
                </div>

                <!-- 9. Transverse Colon -->
                <div class="col-md-6 col-lg-4">
                    <label class="form-label">9. Transverse Colon <span class="text-danger">*</span></label>
                    <select id="pc_findingsTransverseColon" class="form-select pc-findings-select" data-organ="TransverseColon">
                        <option value="">-- Select --</option>
                        <option value="true">NORMAL</option>
                        <option value="false">ABNORMAL</option>
                    </select>
                    <div id="wrap_pc_findingsTransverseColonDetails" style="display:none;"></div>
                </div>

                <!-- 10. Hepatic Flexure -->
                <div class="col-md-6 col-lg-4">
                    <label class="form-label">10. Hepatic Flexure <span class="text-danger">*</span></label>
                    <select id="pc_findingsHepaticFlexure" class="form-select pc-findings-select" data-organ="HepaticFlexure">
                        <option value="">-- Select --</option>
                        <option value="true">NORMAL</option>
                        <option value="false">ABNORMAL</option>
                    </select>
                    <div id="wrap_pc_findingsHepaticFlexureDetails" style="display:none;"></div>
                </div>

                <!-- 11. Ascending Colon -->
                <div class="col-md-6 col-lg-4">
                    <label class="form-label">11. Ascending Colon <span class="text-danger">*</span></label>
                    <select id="pc_findingsAscendingColon" class="form-select pc-findings-select" data-organ="AscendingColon">
                        <option value="">-- Select --</option>
                        <option value="true">NORMAL</option>
                        <option value="false">ABNORMAL</option>
                    </select>
                    <div id="wrap_pc_findingsAscendingColonDetails" style="display:none;"></div>
                </div>

                <!-- 12. Caecum -->
                <div class="col-md-6 col-lg-4">
                    <label class="form-label">12. Caecum <span class="text-danger">*</span></label>
                    <select id="pc_findingsCaecum" class="form-select pc-findings-select" data-organ="Caecum">
                        <option value="">-- Select --</option>
                        <option value="true">NORMAL</option>
                        <option value="false">ABNORMAL</option>
                    </select>
                    <div id="wrap_pc_findingsCaecumDetails" style="display:none;"></div>
                </div>

            </div>
        </div>
    </div>

    <!-- HPE / Polypectomy Section -->
    <div class="card mb-3">
        <div class="card-header">
            <strong>HPE / Polypectomy</strong>
        </div>
        <div class="card-body row g-3">
            <div class="col-md-4">
                <label class="form-label">13. HPE Taken <span class="text-danger">*</span></label>
                <select id="pc_hpeStatus" class="form-select">
                    <option value="">-- Select --</option>
                    <option value="true">YES</option>
                    <option value="false">NO</option>
                </select>
            </div>

            <div class="col-md-8" id="wrap_pc_hpeDetails" style="display:none;">
                <label class="form-label">14. If YES, please specify <span class="text-danger">*</span></label>
                <input id="pc_hpeDetails" class="form-control" type="text" maxlength="500" />
            </div>
        </div>
    </div>

    <!-- Complications Section -->
    <div class="card mb-3">
        <div class="card-header">
            <strong>Complications</strong>
        </div>
        <div class="card-body row g-3">
            <div class="col-md-4">
                <label class="form-label">15. Procedure Complications <span class="text-danger">*</span></label>
                <select id="pc_complications" class="form-select">
                    <option value="">-- Select --</option>
                    <option value="YES">YES</option>
                    <option value="NO">NO</option>
                    <option value="BLEEDING">BLEEDING</option>
                    <option value="PERFORATION">PERFORATION</option>
                </select>
            </div>

            <div class="col-md-8">
                <label class="form-label">16. Complications Details</label>
                <input id="pc_complicationsDetails" class="form-control" type="text" maxlength="500" />
            </div>
        </div>
    </div>

    <!-- Medication Section (NEW) -->
    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Medication</strong>
            <span class="text-muted small">(optional)</span>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-sm align-middle mb-0" id="pc_medicationTable">
                    <thead class="table-light">
                        <tr>
                            <th style="width:35%;">Medication</th>
                            <th>Remarks</th>
                            <th style="width:80px;" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="pc_medicationTableBody">
                        <!-- Rows added dynamically by JS -->
                    </tbody>
                </table>
            </div>
            <button type="button" class="btn btn-sm btn-outline-primary mt-2" id="pc_addMedicationRow">
                <i class="fas fa-plus me-1"></i> Add Medication
            </button>
        </div>
    </div>

    <!-- Discharge Section -->
    <div class="card">
        <div class="card-header">
            <strong>Discharge</strong>
        </div>
        <div class="card-body row g-3">
            <div class="col-md-6">
                <label class="form-label">17. Discharge Plan <span class="text-danger">*</span></label>
                <select id="pc_dischargePlan" class="form-select">
                    <option value="">-- Select --</option>
                    <option value="NORMAL">NORMAL</option>
                    <option value="ABNORMAL">ABNORMAL</option>
                </select>
            </div>
        </div>
    </div>

</div>