                                    <tr>
                                        <td><label class="form-label mb-0">Kudo Pit Pattern</label></td>
                                        <td>
                                            <select id="pcAnomaly_Anus_KudoPitPattern" class="form-select form-select-sm">
                                                <option value="">-- Select --</option>
                                                <option value="I Round pits">I Round pits</option>
                                                <option value="II Stellar/papillary pits">II Stellar/papillary pits</option>
                                                <option value="II-O Open-type pits">II-O Open-type pits</option>
                                                <option value="IIIs Small tubular pits">IIIs Small tubular pits</option>
                                                <option value="IIIL Large tubular pits">IIIL Large tubular pits</option>
                                                <option value="IV Dendritic/gyrus-like">IV Dendritic/gyrus-like</option>
                                                <option value="Vi Irregular pits">Vi Irregular pits</option>
                                                <option value="Vn Non-structural/amorphous">Vn Non-structural/amorphous</option>
                                            </select>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><label class="form-label mb-0">LST Subtype</label></td>
                                        <td>
                                            <select id="pcAnomaly_Anus_LSTSubtype" class="form-select form-select-sm">
                                                <option value="">-- Select --</option>
                                                <option value="LST-G-H">LST-G-H</option>
                                                <option value="LST-G-NM">LST-G-NM</option>
                                                <option value="LST-NG-FE">LST-NG-FE</option>
                                                <option value="LST-NG-PD">LST-NG-PD</option>
                                            </select>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

