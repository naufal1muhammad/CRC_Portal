@{
    ViewData["Title"] = "Staff";
    Layout = "_Layout";

    var staffId = (string)(ViewData["StaffId"] ?? string.Empty);
}

<div class="container-fluid py-3" data-staff-id="@staffId">

    <!-- Header -->
    <div class="d-flex align-items-center mb-3">
        <div>
            <h2 id="staffHeaderName" class="mb-0">Staff: -</h2>
            <small id="staffHeaderId" class="text-muted">
                @if (string.IsNullOrEmpty(staffId))
                {
                    @:New Staff (ID will be generated on save)
                }
                else
                {
                    @:ID: @staffId
                }
            </small>
        </div>

        <div class="ms-auto">
            <a asp-action="Index" asp-controller="Staff"
               class="btn btn-sm btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i> Staff List
            </a>
        </div>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs" id="staffEditTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active"
                    id="tab-basic-details"
                    data-bs-toggle="tab"
                    data-bs-target="#tabBasicDetails"
                    type="button"
                    role="tab">
                Basic Details
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link"
                    id="tab-schedule"
                    data-bs-toggle="tab"
                    data-bs-target="#tabSchedule"
                    type="button"
                    role="tab">
                Schedule
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link"
                    id="tab-performance"
                    data-bs-toggle="tab"
                    data-bs-target="#tabPerformance"
                    type="button"
                    role="tab">
                Performance
            </button>
        </li>
    </ul>

    <!-- Tab contents -->
    <div class="tab-content border border-top-0 p-3 bg-white" id="staffEditTabContent">

        <!-- Basic Details tab -->
        <div class="tab-pane fade show active"
             id="tabBasicDetails"
             role="tabpanel"
             aria-labelledby="tab-basic-details">
            <div id="basicDetailsContent">
                <input type="hidden" id="StaffIdHidden" value="@staffId" />

                <!-- Basic Section -->
                <div class="card bg-light border-0 shadow-sm mb-3">
                    <div class="card-body">
                        <h5 class="card-title mb-3">Basic</h5>

                        <div class="row g-3">
                            <div class="col-lg-6">
                                <div class="mb-2">
                                    <label for="StaffId" class="form-label">ID <span class="text-danger">*</span></label>
                                    <input id="StaffId" type="text" class="form-control form-control-sm" readonly />
                                    <div class="form-text">Auto-generated on save for new staff.</div>
                                </div>

                                <div class="mb-2">
                                    <label for="StaffName" class="form-label">Name <span class="text-danger">*</span></label>
                                    <input id="StaffName" type="text" class="form-control form-control-sm" style="text-transform: uppercase;" />
                                </div>

                                <div class="mb-2">
                                    <label for="StaffNRIC" class="form-label">NRIC <span class="text-danger">*</span></label>
                                    <input id="StaffNRIC"
                                           type="text"
                                           class="form-control form-control-sm"
                                           inputmode="numeric"
                                           minlength="12"
                                           maxlength="12"
                                           pattern="\d{12}"
                                           autocomplete="off" />
                                </div>

                                <div class="mb-2">
                                    <label for="StaffBirthDate" class="form-label">Birth Date (mm/dd/yyyy) <span class="text-danger">*</span></label>
                                    <input id="StaffBirthDate" type="date" class="form-control form-control-sm" readonly />
                                </div>

                                <div class="mb-2">
                                    <label for="StaffAge" class="form-label">Age <span class="text-danger">*</span></label>
                                    <input id="StaffAge" type="number" class="form-control form-control-sm" readonly />
                                    <div class="form-text">Automatically calculated from Birth Date.</div>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="mb-2">
                                    <label for="StaffPhone" class="form-label">Phone <span class="text-danger">*</span></label>
                                    <input id="StaffPhone" type="text" class="form-control form-control-sm" />
                                </div>

                                <div class="mb-2">
                                    <label for="StaffEmail" class="form-label">Email <span class="text-danger">*</span></label>
                                    <input id="StaffEmail" type="email" class="form-control form-control-sm" />
                                </div>

                                <div class="mb-2">
                                    <label for="StaffGender" class="form-label">Gender <span class="text-danger">*</span></label>
                                    <select id="StaffGender" class="form-select form-select-sm" disabled>
                                        <option value="">-- Select Gender --</option>
                                        <option value="Male">Male</option>
                                        <option value="Female">Female</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Residential Address Section -->
                <div class="card bg-light border-0 shadow-sm mb-3">
                    <div class="card-body">
                        <h5 class="card-title mb-3">Residential</h5>

                        <div class="row g-3">
                            <div class="col-md-4">
                                <label for="StaffResState" class="form-label">State <span class="text-danger">*</span></label>
                                <select id="StaffResState" class="form-select form-select-sm select2">
                                    <option value="">-- Select State --</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label for="StaffResCity" class="form-label">City <span class="text-danger">*</span></label>
                                <select id="StaffResCity" class="form-select form-select-sm select2" disabled>
                                    <option value="">-- Select City --</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label for="StaffResPostcode" class="form-label">Postcode <span class="text-danger">*</span></label>
                                <select id="StaffResPostcode" class="form-select form-select-sm select2" disabled>
                                    <option value="">-- Select Postcode --</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label for="StaffAddLine1" class="form-label">Address Line 1 <span class="text-danger">*</span></label>
                                <textarea id="StaffAddLine1" class="form-control form-control-sm" rows="2" disabled></textarea>
                            </div>
                            <div class="col-md-6">
                                <label for="StaffAddLine2" class="form-label">Address Line 2 <span class="text-danger">*</span></label>
                                <textarea id="StaffAddLine2" class="form-control form-control-sm" rows="2" disabled></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Employment Section -->
                <div class="card bg-light border-0 shadow-sm mb-3">
                    <div class="card-body">
                        <h5 class="card-title mb-3">Employment Section</h5>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="StaffBase" class="form-label">Base <span class="text-danger">*</span></label>
                                <input id="StaffBase" type="text" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-6">
                                <label for="StaffType" class="form-label">Staff Type <span class="text-danger">*</span></label>
                                <select id="StaffType" class="form-select form-select-sm">
                                    <option value="">-- Select Staff Type --</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Documents Section -->
                <div class="card bg-light border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                            <h5 class="card-title mb-0">Documents</h5>
                            <small class="text-muted">Files will be uploaded when you click <strong>Save</strong>.</small>
                        </div>

                        <div id="staffDocumentsMessage" class="text-danger small mb-2"></div>
                        <div id="staffDocumentsContainer">
                            <p class="text-muted mb-0">Loading document types...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Schedule tab -->
        <div class="tab-pane fade"
             id="tabSchedule"
             role="tabpanel"
             aria-labelledby="tab-schedule">

            <div id="staffScheduleContent">
                <div id="staffScheduleInfo" class="alert alert-info py-2 small d-none">
                    Please save the staff first before managing schedule slots.
                </div>

                <!-- Create Slots -->
                <div class="card bg-light border-0 shadow-sm mb-3">
                    <div class="card-body">
                        <h5 class="card-title mb-3">Create Slots</h5>

                        <div class="row g-3 align-items-end">
                            <div class="col-md-3">
                                <label for="ScheduleFromDate" class="form-label">From Date <span class="text-danger">*</span></label>
                                <input id="ScheduleFromDate" type="date" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-3">
                                <label for="ScheduleToDate" class="form-label">To Date <span class="text-danger">*</span></label>
                                <input id="ScheduleToDate" type="date" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-2">
                                <label for="ScheduleStartTime" class="form-label">Start Time <span class="text-danger">*</span></label>
                                <input id="ScheduleStartTime" type="time" step="3600" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-2">
                                <label for="ScheduleEndTime" class="form-label">End Time <span class="text-danger">*</span></label>
                                <input id="ScheduleEndTime" type="time" step="3600" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-2 d-grid">
                                <button id="btnCreateStaffSlots" type="button" class="btn btn-primary btn-sm">
                                    <i class="fas fa-plus me-1"></i> Create Slots
                                </button>
                            </div>
                        </div>

                        <div id="staffScheduleMessage" class="small mt-2"></div>
                    </div>
                </div>

                <!-- Slots Grid -->
                <div class="card bg-light border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-2">
                            <h5 class="card-title mb-0">Slots</h5>

                            <div class="d-flex flex-wrap gap-2 align-items-end">
                                <div>
                                    <label for="ScheduleFilterFrom" class="form-label mb-0 small">Filter From</label>
                                    <input id="ScheduleFilterFrom" type="date" class="form-control form-control-sm" />
                                </div>
                                <div>
                                    <label for="ScheduleFilterTo" class="form-label mb-0 small">Filter To</label>
                                    <input id="ScheduleFilterTo" type="date" class="form-control form-control-sm" />
                                </div>
                                <button id="btnFilterSlots" type="button" class="btn btn-outline-secondary btn-sm">
                                    <i class="fas fa-filter me-1"></i> Apply
                                </button>
                                <button id="btnClearFilterSlots" type="button" class="btn btn-outline-secondary btn-sm">
                                    <i class="fas fa-times me-1"></i> Clear
                                </button>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table id="staffSlotsTable" class="table table-striped table-sm table-bordered align-middle w-100">
                                <thead class="table-secondary">
                                    <tr>
                                        <th scope="col" class="text-nowrap">Date</th>
                                        <th scope="col" class="text-nowrap">Start Time</th>
                                        <th scope="col" class="text-nowrap">End Time</th>
                                        <th scope="col" class="text-nowrap">Status</th>
                                        <th scope="col" class="text-center" style="width: 140px;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- populated by JS -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Performance tab -->
        <div class="tab-pane fade"
             id="tabPerformance"
             role="tabpanel"
             aria-labelledby="tab-performance">
        </div>
    </div>

    <div id="staffBasicMessage" class="text-danger small mb-2"></div>

    <!-- Global Save button -->
    <div class="mt-3 d-flex justify-content-end">
        <button id="btnSaveStaffMain"
                type="button"
                class="btn btn-primary">
            <i class="fas fa-save me-1"></i> Save
        </button>
    </div>

    <!-- Save Success Modal -->
    <div class="modal fade" id="saveSuccessModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content text-center p-4">
                <div class="modal-body">
                    <div class="display-3 text-success mb-3">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <h5 class="mb-2">Saved Successfully</h5>
                    <p class="text-muted mb-3">Staff details have been saved.</p>
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">
                        OK
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/staff/edit-staffbasic.js"></script>
    <script src="~/js/staff/edit-staffschedule.js"></script>
    <script src="~/js/staff/edit-staffperformance.js"></script>
}
