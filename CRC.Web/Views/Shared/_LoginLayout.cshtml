@*
    CRC portal login / identity layout.
    A logo plate sits above a split card: the branded panel (CRC identity) on the
    left, and the page's form (RenderBody) on the right. Shared by every auth view —
    Login and AccessDenied both get the same shell for free.

    Use it from any auth view, e.g.:
        @{ Layout = "_LoginLayout"; }
    Each view supplies only its form/heading; the logo and brand panel live here.
*@
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/images/nucentra-icon.png" />
    <title>@ViewData["Title"] - CRC Portal</title>
    <link rel="stylesheet" href="~/lib/fortawesome/fontawesome-free/css/all.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/lib/admin-lte/css/adminlte.min.css">
    <link rel="stylesheet" href="~/lib/toastify-js/src/toastify.css">
    <link rel="stylesheet" href="~/css/site.css">

    @await RenderSectionAsync("Stylesheets", required: false)
</head>

<body class="hold-transition identity-page">
    <div class="identity-shell">
        <img src="~/images/nucentra-logo.png" alt="CRC Portal" class="identity-logo">

        <div class="identity-card">
            <aside class="identity-brand">
                <h2 class="identity-brand-title">CRC PORTAL</h2>
                <p class="identity-brand-subtitle">Nucentra Digital Healthcare Portal</p>
                <p class="identity-brand-note">
                    The information you are about to access is strictly confidential and intended
                    solely for authorised personnel. Any unauthorised access or use may be subject
                    to legal and disciplinary proceedings.
                </p>
            </aside>

            <div class="identity-form">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/admin-lte/js/adminlte.min.js"></script>
    <script src="~/lib/toastify-js/src/toastify.js"></script>
    <script src="~/js/classes/Resource.js"></script>
    <script src="~/js/common/toast.js"></script>
    <script src="~/js/functions/SessionTimeout.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
