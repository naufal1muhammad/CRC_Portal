@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_Layout";
}

<div class="container-fluid py-3">

    <!-- Row 1: Today's Appointments (inside a card) -->
    <div class="card mb-3">
        <div class="card-header d-flex align-items-center justify-content-between">
            <div>
                <h5 class="mb-0">Today’s Appointments</h5>
                <small class="text-muted">Shows appointments scheduled for today only.</small>
            </div>

            <div class="d-flex align-items-center" style="gap: 8px;">
                <label class="small text-muted mb-0">Branch</label>
                <select id="ddlTodayAppointmentsBranch" class="form-select form-select-sm select2" style="min-width: 240px;">
                    <option value="">All Branches</option>
                </select>
            </div>
        </div>

        <div class="card-body">
            <div id="adminDashboardMessage" class="small text-muted mb-2"></div>

            <div class="table-responsive">
                <table id="todayAppointmentsTable" class="table table-sm table-striped mb-0">
                    <thead class="table-secondary">
                        <tr>
                            <th>Patient ID</th>
                            <th>Patient Name</th>
                            <th>Phone</th>
                            <th>Email</th>
                            <th>Appointment Type</th>
                            <th>Attendance Status</th>
                            <th>Assigned Staff</th>
                            <th>Branch</th>
                            <th>Date &amp; Time</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="9" class="text-center text-muted">Loading...</td>
                        </tr>
                    </tbody>
                </table>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/adminDashboard/index.js"></script>
}