@{
    ViewData["Title"] = "Dashboard";
    Layout = "_Layout";
}

<div class="container-fluid py-3">
    <h2 class="mb-3">Dashboard</h2>

    <div id="dashboardMessage" class="small text-danger mb-3"></div>

    <!-- =======================
         ROW 1 - KPI CARDS
    ======================== -->
    <div class="row g-3 mb-3">

        <!-- Card 1: Active Branches -->
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h6 class="text-muted mb-1">Active Branches</h6>
                        <div class="display-5 fw-semibold" id="kpiActiveBranches">-</div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- =======================
         ROW 2 - PIE CHARTS
    ======================== -->
    <div class="row g-3 mb-3">

        <!-- Patients by Race -->
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header">
                    <h6 class="mb-0">Patients by Race</h6>
                </div>
                <div class="card-body">
                    <canvas id="chartPatientsByRace" class="dashboard-chart-sm"></canvas>
                </div>
            </div>
        </div>

        <!-- Patients by Age Group -->
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header">
                    <h6 class="mb-0">Patients by Age Group</h6>
                </div>
                <div class="card-body">
                    <canvas id="chartPatientsByAgeGroup" class="dashboard-chart-sm"></canvas>
                </div>
            </div>
        </div>

    </div>

    <!-- =======================
         ROW 3 - BAR CHART
    ======================== -->
    <div class="row g-3 mb-3">
        <div class="col-12">
            <div class="card h-100">
                <div class="card-header">
                    <h6 class="mb-0">Patients by Discharge Type</h6>
                </div>
                <div class="card-body">
                    <canvas id="chartPatientsByDischargeType" class="dashboard-chart-md"></canvas>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/dashboard/index.js"></script>
}
