@model CRC.Web.Controllers.AccountController.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
    Layout = "_Layout";
}

<div class="container mt-5">
    <h2 class="mb-4">Change Password</h2>

    <div class="card">
        <div class="card-body">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success" role="alert">
                    @TempData["SuccessMessage"]
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger" role="alert">
                    @TempData["ErrorMessage"]
                </div>
            }

            <form asp-controller="Account" asp-action="ChangePassword" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">User Name</label>
                        <input class="form-control bg-light" value="@Model.UserName" readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">User Type</label>
                        <input class="form-control bg-light" value="@Model.UserType" readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Staff ID</label>
                        <input class="form-control bg-light" value="@(string.IsNullOrWhiteSpace(Model.StaffId) ? "-" : Model.StaffId)" readonly />
                        <div class="form-text">Only applicable for STAFF users.</div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Email</label>
                        <input class="form-control bg-light" value="@Model.Email" readonly />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CurrentPassword" class="form-label">Current Password</label>
                        <input asp-for="CurrentPassword" class="form-control" type="password" autocomplete="current-password" />
                        <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                    </div>

                    <div class="col-md-6"></div>

                    <div class="col-md-6">
                        <label asp-for="NewPassword" class="form-label">New Password</label>
                        <input asp-for="NewPassword" class="form-control" type="password" autocomplete="new-password" />
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                        <input asp-for="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-key me-2"></i> Update Password
                    </button>
                    <button type="button" class="btn btn-outline-secondary" onclick="history.back()">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}