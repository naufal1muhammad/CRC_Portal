@{
    ViewData["Title"] = "Register User";
    Layout = "_Layout";
}

<div class="container mt-5">
    <h2 class="mb-4">User Management</h2>

    <!-- Users table (top) -->
    <div class="card mb-4">
        <div class="card-header d-flex align-items-center justify-content-between">
            <h5 class="mb-0">Users</h5>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table id="usersTable" class="table table-striped table-hover w-100">
                    <thead>
                        <tr>
                            <th>User ID</th>
                            <th>Name</th>
                            <th>Username</th>
                            <th>Email</th>
                            <th>User Type</th>
                            <th>Staff ID</th>
                            <th>Created At</th>
                            <th>Last Login</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Register form (below) -->
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Register</h5>
        </div>

        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label for="Name" class="form-label">Name</label>
                        <input id="Name" class="form-control" type="text" />
                        <div class="form-text">
                            For STAFF users, this should match the staff record (we’ll help enforce this in JS).
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="Username" class="form-label">Username</label>
                        <input id="Username" class="form-control" type="text" />
                    </div>

                    <div class="mb-3">
                        <label for="Email" class="form-label">Email</label>
                        <input id="Email" class="form-control" type="email" />
                    </div>

                    <div class="mb-3">
                        <label for="Password" class="form-label">Password</label>
                        <input id="Password" class="form-control" type="password" />
                    </div>

                    <div class="mb-3">
                        <label for="UserType" class="form-label">User Type</label>
                        <select id="UserType" class="form-select">
                            <option value="1">SUPERUSER</option>
                            <option value="2" selected>ADMIN</option>
                            <option value="3">STAFF</option>
                        </select>
                    </div>

                    <div id="staffLinkGroup" class="mb-3 d-none">
                        <label for="StaffId" class="form-label">Link to Staff</label>
                        <select id="StaffId" class="form-select">
                            <option value="">-- Select Staff --</option>
                        </select>
                        <div class="form-text">
                            Required only when User Type is STAFF. This will populate dbo.Users.Staff_ID.
                        </div>
                    </div>

                    <button id="btnRegister" class="btn btn-primary" type="button">Register</button>

                    <div class="mt-3">
                        <span id="registerMessage"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/account/register.js"></script>
}