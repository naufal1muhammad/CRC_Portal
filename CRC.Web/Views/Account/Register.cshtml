@using Microsoft.Extensions.Options
@using CRC.Web.Models
@inject IOptions<PasswordPolicyOptions> PasswordPolicyOptions
@{
    ViewData["Title"] = "User Management";
    Layout = "_Layout";
}

<div class="container mt-5">
    <h2 class="mb-4">User Management</h2>

    <!-- Users table (top) -->
    <div class="card mb-4">
        <div class="card-header">
            <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between">
                <h5 class="mb-0">Users</h5>

                <div class="d-flex gap-2 align-items-center">
                    <div class="input-group input-group-sm" style="width: 280px;">
                        <span class="input-group-text"><i class="fas fa-search"></i></span>
                        <input id="usersSearch" type="text" class="form-control" placeholder="Search users..." />
                    </div>

                    <button id="btnAddUser" class="btn btn-sm btn-primary" type="button">
                        <i class="fas fa-user-plus me-1"></i> Add User
                    </button>
                </div>
            </div>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table id="usersTable" class="table table-striped table-hover w-100">
                    <thead>
                        <tr>
                            <th>User ID</th>
                            <th>Name</th>
                            <th>Username</th>
                            <th>Email</th>
                            <th>User Type</th>
                            <th>Staff ID</th>
                            <th>Created At</th>
                            <th>Last Login</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Add User Modal -->
<div class="modal fade" id="addUserModal" tabindex="-1" aria-labelledby="addUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addUserModalLabel">Add User</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div class="row">
                    <div class="col-md-12">
                        <div class="mb-3">
                            <label for="Name" class="form-label">Name</label>
                            <input id="Name" class="form-control" type="text" />
                            <div class="form-text">
                                For STAFF users, this will be auto-filled based on the selected staff record.
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="Username" class="form-label">Username</label>
                            <input id="Username" class="form-control" type="text" />
                        </div>

                        <div class="mb-3">
                            <label for="Email" class="form-label">Email</label>
                            <input id="Email" class="form-control" type="email" />
                        </div>

                        <div class="mb-3">
                            <label for="Password" class="form-label">Password</label>
                            <input id="Password" class="form-control" type="password" />
                            <div class="form-text text-muted">
                                @{
                                    var pp = PasswordPolicyOptions.Value;
                                    var hints = new List<string> { $"at least {pp.RequiredLength} characters" };
                                    if (pp.RequireUppercase) hints.Add("an uppercase letter");
                                    if (pp.RequireLowercase) hints.Add("a lowercase letter");
                                    if (pp.RequireDigit) hints.Add("a digit");
                                    if (pp.RequireNonAlphanumeric) hints.Add("a special character");
                                    if (pp.RequiredUniqueChars > 1) hints.Add($"{pp.RequiredUniqueChars} unique characters");
                                }
                                Password must contain @string.Join(", ", hints).
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="UserType" class="form-label">User Type</label>
                            <select id="UserType" class="form-select">
                                <option value="1">SUPERUSER</option>
                                <option value="2" selected>ADMIN</option>
                                <option value="3">STAFF</option>
                            </select>
                        </div>

                        <div id="staffLinkGroup" class="mb-3 d-none">
                            <label for="StaffId" class="form-label">Link to Staff</label>
                            <select id="StaffId" class="form-select">
                                <option value="">-- Select Staff --</option>
                            </select>
                            <div class="form-text">
                                Required only when User Type is STAFF. One Staff ID can only be linked to one user account.
                            </div>
                        </div>

                        <div class="mt-2">
                            <span id="registerMessage"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button id="btnRegister" type="button" class="btn btn-primary">Register</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/account/register.js"></script>
}